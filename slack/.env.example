# Bot token (xoxb-...), from OAuth & Permissions after installing the app.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-level token (xapp-...) with the connections:write scope, for socket mode.
SLACK_APP_TOKEN=xapp-your-app-token

# Where the time-slay binary is. Defaults to `time-slay` on PATH.
# TIMESLAY_BIN=/absolute/path/to/time-slay

# How long to wait for the binary. Defaults to 30000.
# TIMESLAY_TIMEOUT_MS=30000

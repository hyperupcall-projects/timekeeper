{
  "name": "tasks-bridge",
  "version": "0.1.0",
  "exports": "./main.ts",
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  },
  "tasks": {
    "signin": "deno run --allow-all main.ts signin",
    "status": "deno run --allow-all main.ts status",
    "dump": "deno run --allow-all main.ts dump",
    "fetch": "deno run --allow-all main.ts fetch",
    "selftest": "deno run --allow-all main.ts selftest",
    "compile": "deno compile --allow-all --output tasks-bridge main.ts"
  }
}

{
  "manifest_version": 3,
  "name": "TimeSlay — Add to inbox",
  "version": "0.1.0",
  "description": "Send the page you are looking at to your TimeSlay inbox.",
  "permissions": ["activeTab", "tabs", "nativeMessaging"],
  "action": {
    "default_title": "Add to inbox",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "timeslay@example.org",
      "strict_min_version": "109.0"
    }
  },
  "key": ""
}

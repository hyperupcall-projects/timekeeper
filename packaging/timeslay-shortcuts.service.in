[Unit]
Description=TimeSlay shortcut daemon
# Owns the global shortcuts (Toggle Visibility, Meta+U by default, and Toggle
# Shape, Meta+Shift+U) and shows, hides and switches the side panel and the
# dock when they fire. The dock is Wayland-only: a layer surface needs a
# compositor that speaks zwlr_layer_shell_v1 (KWin does).
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@EXEC@ --daemon
Restart=on-failure
RestartSec=2

# systemd's user manager does not inherit the session's environment on its own,
# so pull the display variables in explicitly. `%t` is the runtime directory.
Environment=XDG_RUNTIME_DIR=%t
# Uncomment and adjust if your compositor does not export this to the user
# manager (most Wayland sessions do):
#Environment=WAYLAND_DISPLAY=wayland-0

[Install]
WantedBy=graphical-session.target
